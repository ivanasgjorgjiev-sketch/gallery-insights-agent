# Copy this file to .streamlit/secrets.toml and fill in real values.
# .streamlit/secrets.toml is git-ignored and must never be committed.
# On Streamlit Community Cloud, paste the same lines into the app's "Secrets" settings instead.
#
# Not needed until Milestone 3 (the LLM agent).

#
# GIA_MODE: "demo" (default: replays a recorded investigation, makes no API calls)
#           or "live" (real Claude API calls). Never set "live" on the public deployment.

GIA_MODE = "live"
ANTHROPIC_API_KEY = "sk-ant-..."
GIA_MODEL = "claude-sonnet-5-5"
